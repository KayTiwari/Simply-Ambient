{
  "expo": {
    "name": "Simply Ambient",
    "slug": "simply-ambient",
    "version": "1.0.1",
    "description": "Your spiritual center. Binaural frequencies, breath work, chakras, horoscopes, and grounded tools for daily practice.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B1F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.likechess.simplyambient",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.likechess.simplyambient",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "like-chess"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a3a1f2b0-b321-4dcf-8bc4-d9b05a32bd80"
      }
    },
    "owner": "like-chess"
  }
}
